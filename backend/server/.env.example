# ============================================================
#  Dragyou Platform Backend — Environment Configuration
#  Copy this to .env and fill in your values.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080
ENV=development        # development | production

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=dragyou
DB_PASSWORD=dragyou
DB_NAME=dragyou
DB_SSLMODE=disable     # disable | require | verify-full

# ── JWT Authentication ────────────────────────────────────────
# CHANGE THIS in production — use at least 32 random characters
JWT_SECRET=change-me-in-production-use-32+chars
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Repository Storage ────────────────────────────────────────
# Where .nova/ repos are stored on disk
REPO_STORAGE_PATH=./repos

# ── Rate Limiting (requests per minute) ──────────────────────
RATE_LIMIT_ANON=100
RATE_LIMIT_AUTHED=1000

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Nova CLI binary ───────────────────────────────────────────
# Path to the compiled nova binary (engine bridge)
# Defaults to "nova" on PATH if not set
# NOVA_BIN=/usr/local/bin/nova
